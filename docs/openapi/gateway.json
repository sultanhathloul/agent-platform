{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Agent Platform Gateway API",
    "version" : "1.2.0"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Gateway"
  } ],
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/v1/chat/turns" : {
      "post" : {
        "description" : "Streams agent events as Server-Sent Events. Event payloads are defined in docs/events.schema.json. Errors before the stream starts are JSON envelopes.",
        "operationId" : "turn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChatTurnRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "SSE stream of agent events"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "invalid_request"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "unauthorized"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "kb_forbidden or conversation_forbidden"
          },
          "502" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "agent_unavailable"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "audit_unavailable"
          }
        },
        "summary" : "Run one chat turn",
        "tags" : [ "chat" ]
      }
    },
    "/v1/health" : {
      "get" : {
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Liveness of the gateway itself",
        "tags" : [ "health" ]
      }
    },
    "/v1/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiEnvelopeMeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Current user, tenant and permissions",
        "tags" : [ "identity" ]
      }
    },
    "/v1/memory" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiEnvelopeMemoryList"
                }
              }
            },
            "description" : "The caller's memory"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "unauthorized"
          },
          "502" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "agent_unavailable"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "audit_unavailable"
          }
        },
        "summary" : "The caller's memory items and memory switch",
        "tags" : [ "memory" ]
      }
    },
    "/v1/memory/settings" : {
      "put" : {
        "operationId" : "settings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MemorySettings"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiEnvelopeMemorySettings"
                }
              }
            },
            "description" : "The caller's memory switch as saved"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "invalid_request"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "unauthorized"
          },
          "502" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "agent_unavailable"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "audit_unavailable"
          }
        },
        "summary" : "Turns the caller's memory on or off",
        "tags" : [ "memory" ]
      }
    },
    "/v1/memory/{itemId}" : {
      "delete" : {
        "operationId" : "delete",
        "parameters" : [ {
          "in" : "path",
          "name" : "itemId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "The item is deleted"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "invalid_request"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "unauthorized"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "memory_not_found, also for another user's item"
          },
          "502" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "agent_unavailable"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorEnvelope"
                }
              }
            },
            "description" : "audit_unavailable"
          }
        },
        "summary" : "Deletes one of the caller's memory items",
        "tags" : [ "memory" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ApiEnvelopeMeResponse" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/MeResponse"
          },
          "error" : {
            "$ref" : "#/components/schemas/ApiError"
          },
          "request_id" : {
            "type" : "string"
          }
        },
        "required" : [ "request_id" ]
      },
      "ApiEnvelopeMemoryList" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/MemoryList"
          },
          "error" : {
            "$ref" : "#/components/schemas/ApiError"
          },
          "request_id" : {
            "type" : "string"
          }
        },
        "required" : [ "request_id" ]
      },
      "ApiEnvelopeMemorySettings" : {
        "properties" : {
          "data" : {
            "$ref" : "#/components/schemas/MemorySettings"
          },
          "error" : {
            "$ref" : "#/components/schemas/ApiError"
          },
          "request_id" : {
            "type" : "string"
          }
        },
        "required" : [ "request_id" ]
      },
      "ApiError" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message_ar" : {
            "type" : "string"
          },
          "message_en" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "message_ar", "message_en" ]
      },
      "ApiErrorEnvelope" : {
        "properties" : {
          "error" : {
            "$ref" : "#/components/schemas/ApiError"
          },
          "request_id" : {
            "type" : "string"
          }
        },
        "required" : [ "error", "request_id" ]
      },
      "Attachment" : {
        "default" : [ ],
        "properties" : {
          "id" : {
            "type" : "string",
            "minLength" : 1
          },
          "mime" : {
            "type" : "string",
            "minLength" : 1
          },
          "name" : {
            "type" : "string",
            "minLength" : 1
          },
          "size" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "id", "mime", "name" ]
      },
      "ChatTurnRequest" : {
        "properties" : {
          "attachments" : {
            "type" : "array",
            "default" : [ ],
            "items" : {
              "$ref" : "#/components/schemas/Attachment"
            },
            "maxItems" : 20,
            "minItems" : 0
          },
          "conversation_id" : {
            "type" : "string",
            "format" : "uuid",
            "pattern" : "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "locale" : {
            "type" : "string",
            "default" : "ar",
            "enum" : [ "ar", "en" ],
            "pattern" : "^(ar|en)$"
          },
          "message" : {
            "type" : "string",
            "maxLength" : 8000,
            "minLength" : 0
          },
          "selected_kbs" : {
            "type" : "array",
            "default" : [ ],
            "items" : {
              "type" : "string",
              "default" : "[]",
              "pattern" : "^[a-z0-9_-]{1,64}$"
            },
            "maxItems" : 20,
            "minItems" : 0
          }
        },
        "required" : [ "conversation_id", "message" ]
      },
      "HealthResponse" : {
        "properties" : {
          "status" : {
            "type" : "string"
          }
        }
      },
      "MeResponse" : {
        "properties" : {
          "display_name" : {
            "type" : "string"
          },
          "is_admin" : {
            "type" : "boolean"
          },
          "permissions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "tenant_id" : {
            "type" : "string"
          },
          "user_id" : {
            "type" : "string"
          }
        },
        "required" : [ "is_admin", "permissions", "tenant_id", "user_id" ]
      },
      "MemoryItem" : {
        "properties" : {
          "confidence" : {
            "type" : "number",
            "format" : "double"
          },
          "created_at" : {
            "type" : "string",
            "format" : "date-time"
          },
          "expires_at" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Absent while the item has no expiry."
          },
          "id" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string",
            "description" : "preference | fact_about_user | project_context | decision"
          },
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "confidence", "created_at", "id", "kind", "text" ]
      },
      "MemoryList" : {
        "properties" : {
          "enabled" : {
            "type" : "boolean",
            "description" : "Whether memory is written and retrieved for the caller."
          },
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MemoryItem"
            }
          }
        },
        "required" : [ "enabled", "items" ]
      },
      "MemorySettings" : {
        "properties" : {
          "enabled" : {
            "type" : "boolean"
          }
        },
        "required" : [ "enabled" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
