{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Platform Agent API (internal)",
    "description": "Internal API called only by the gateway (README §6.2).",
    "version": "1.2.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/turns": {
      "post": {
        "summary": "Create Turn",
        "operationId": "create_turn_v1_turns_post",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-sent events; each `data` is an AgentEvent (docs/events.schema.json).",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/conversations/{conversation_id}/turns/{turn_id}/retract": {
      "post": {
        "summary": "Retract Turn",
        "description": "Withdraws a persisted reply from the history (ADR-0048). Called by the gateway\nwhen a finished turn's audit record cannot be written.",
        "operationId": "retract_turn_v1_conversations__conversation_id__turns__turn_id__retract_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Conversation Id"
            }
          },
          {
            "name": "turn_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Turn Id"
            }
          },
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetractRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The reply is marked retracted; Context Assembly no longer includes it."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "description": "conversation_forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "turn_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memory": {
      "get": {
        "summary": "List Memory",
        "description": "The caller's own memory items and memory switch (README §8). No endpoint reads\nanother user's memory.",
        "operationId": "list_memory_v1_memory_get",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's user id.",
              "title": "X-User-Id"
            },
            "description": "The caller's user id."
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's tenant id.",
              "title": "X-Tenant-Id"
            },
            "description": "The caller's tenant id."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryList"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/memory/{item_id}": {
      "delete": {
        "summary": "Delete Memory",
        "operationId": "delete_memory_v1_memory__item_id__delete",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Item Id"
            }
          },
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's user id.",
              "title": "X-User-Id"
            },
            "description": "The caller's user id."
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's tenant id.",
              "title": "X-Tenant-Id"
            },
            "description": "The caller's tenant id."
          }
        ],
        "responses": {
          "204": {
            "description": "The item is deleted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "description": "memory_not_found, also for another user's item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memory/settings": {
      "put": {
        "summary": "Update Memory Settings",
        "description": "Turns the caller's memory on or off. Off, nothing is written or retrieved for\nthem; stored items stay until they delete them.",
        "operationId": "update_memory_settings_v1_memory_settings_put",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's user id.",
              "title": "X-User-Id"
            },
            "description": "The caller's user id."
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's tenant id.",
              "title": "X-Tenant-Id"
            },
            "description": "The caller's tenant id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemorySettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemorySettings"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/debug/context/{turn_id}": {
      "get": {
        "summary": "Debug Context",
        "description": "What every model call of a turn saw (README §7). Off unless DEBUG_CONTEXT_ENABLED.\nIt reaches a conversation outside a turn, so it does not go through the turn\nrunner's binding and checks ownership itself: only the conversation's owner\nreads it (ADR-0059).",
        "operationId": "debug_context_v1_debug_context__turn_id__get",
        "parameters": [
          {
            "name": "turn_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Turn Id"
            }
          },
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Token"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's user id.",
              "title": "X-User-Id"
            },
            "description": "The caller's user id."
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "The caller's tenant id.",
              "title": "X-Tenant-Id"
            },
            "description": "The caller's tenant id."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DebugContext"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "description": "conversation_forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "not_found (disabled) or turn_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message_ar": {
            "type": "string",
            "title": "Message Ar"
          },
          "message_en": {
            "type": "string",
            "title": "Message En"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message_ar",
          "message_en"
        ],
        "title": "ApiError"
      },
      "AttachmentRef": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "mime": {
            "type": "string",
            "title": "Mime"
          },
          "size": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "mime",
          "size"
        ],
        "title": "AttachmentRef"
      },
      "DebugContext": {
        "properties": {
          "turn_id": {
            "type": "string",
            "title": "Turn Id"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "packages": {
            "items": {
              "$ref": "#/components/schemas/RecordedContext"
            },
            "type": "array",
            "title": "Packages",
            "description": "Every model call of the turn, in assembly order."
          }
        },
        "type": "object",
        "required": [
          "turn_id",
          "conversation_id",
          "packages"
        ],
        "title": "DebugContext"
      },
      "ErrorEnvelope": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "type": "object",
        "required": [
          "status",
          "capabilities"
        ],
        "title": "HealthResponse"
      },
      "MemoryItemView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "description": "preference | fact_about_user | project_context | decision (README §8)."
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "text",
          "confidence",
          "created_at"
        ],
        "title": "MemoryItemView"
      },
      "MemoryList": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "Whether memory is written and retrieved for this user."
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemoryItemView"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "items"
        ],
        "title": "MemoryList"
      },
      "MemorySettings": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "MemorySettings"
      },
      "Principal": {
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id"
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "title": "Tenant Id",
            "default": "default"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions",
            "default": []
          },
          "max_tier": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fast",
                  "standard",
                  "heavy"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tier"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "default": ""
          },
          "locale": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Locale",
            "default": "ar"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "Principal"
      },
      "RecordedContext": {
        "properties": {
          "node": {
            "type": "string",
            "title": "Node"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "package": {
            "additionalProperties": true,
            "type": "object",
            "title": "Package",
            "description": "The ContextPackage a model call received, with its accounting."
          }
        },
        "type": "object",
        "required": [
          "node",
          "created_at",
          "package"
        ],
        "title": "RecordedContext"
      },
      "RetractRequest": {
        "properties": {
          "principal": {
            "$ref": "#/components/schemas/Principal"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z_]{1,64}$",
            "title": "Reason",
            "description": "Error code that withdrew the reply."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "principal",
          "reason"
        ],
        "title": "RetractRequest"
      },
      "TurnRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Conversation Id",
            "description": "UUID, lower-case; the gateway normalises it (ADR-0050)."
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message"
          },
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/AttachmentRef"
            },
            "type": "array",
            "title": "Attachments",
            "default": []
          },
          "selected_kbs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selected Kbs",
            "default": []
          },
          "locale": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ],
            "title": "Locale",
            "default": "ar"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "principal",
          "message"
        ],
        "title": "TurnRequest"
      }
