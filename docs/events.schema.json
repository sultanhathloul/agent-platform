{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.local/schemas/events.v1.json",
  "title": "AgentEvent",
  "description": "One SSE event streamed by POST /v1/turns (agent) and POST /v1/chat/turns (gateway).",
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source": {
          "description": "Kind of source, e.g. web, doc, kb, sql.",
          "title": "Source",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "kb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page, section or row range inside the source.",
          "title": "Locator"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The attachment (or KB document) the answer drew on (ADR-0140).",
          "title": "Document Id"
        },
        "pages": {
          "default": [],
          "description": "Pages of that document the answer drew on, ascending (ADR-0140).",
          "items": {
            "type": "integer"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "source"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationEvent": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "citation",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/Citation"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "CitationEvent",
      "type": "object"
    },
    "DoneData": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "guard_events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GuardData"
          },
          "title": "Guard Events",
          "type": "array"
        },
        "guard_audit": {
          "default": [],
          "description": "Agent to gateway only (ADR-0116): every guard evaluation in full, for the audit record. The gateway removes this field before relaying the event; a client never receives it.",
          "items": {
            "$ref": "#/$defs/GuardAuditData"
          },
          "title": "Guard Audit",
          "type": "array"
        },
        "tool_audit": {
          "default": [],
          "description": "Agent to gateway only (G8): every tool call of the turn, content-free, for the audit record. The gateway removes this field before relaying the event; a client never receives it.",
          "items": {
            "$ref": "#/$defs/ToolAuditData"
          },
          "title": "Tool Audit",
          "type": "array"
        },
        "state_digest": {
          "$ref": "#/$defs/StateDigest"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "answer",
        "usage",
        "state_digest"
      ],
      "title": "DoneData",
      "type": "object"
    },
    "DoneEvent": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "done",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/DoneData"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "DoneEvent",
      "type": "object"
    },
    "ErrorData": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message_ar": {
          "title": "Message Ar",
          "type": "string"
        },
        "message_en": {
          "title": "Message En",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "policy_id@version whose block ended the turn; its messages are the policy's.",
          "title": "Policy Id"
        },
        "guard_events": {
          "default": [],
          "description": "The turn's guard events up to the error.",
          "items": {
            "$ref": "#/$defs/GuardData"
          },
          "title": "Guard Events",
          "type": "array"
        },
        "guard_audit": {
          "default": [],
          "description": "Agent to gateway only (ADR-0116): every guard evaluation in full, for the audit record. The gateway removes this field before relaying the event; a client never receives it.",
          "items": {
            "$ref": "#/$defs/GuardAuditData"
          },
          "title": "Guard Audit",
          "type": "array"
        },
        "tool_audit": {
          "default": [],
          "description": "Agent to gateway only (G8): every tool call of the turn, content-free, for the audit record. The gateway removes this field before relaying the event; a client never receives it.",
          "items": {
            "$ref": "#/$defs/ToolAuditData"
          },
          "title": "Tool Audit",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message_ar",
        "message_en"
      ],
      "title": "ErrorData",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ErrorData"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "GuardAuditData": {
      "additionalProperties": false,
      "description": "A guard evaluation in full, for the gateway's audit record only (ADR-0116). It travels in\nthe terminal event's `guard_audit`, which the gateway removes before the event reaches a\nclient; a client never receives one.",
      "properties": {
        "checkpoint": {
          "title": "Checkpoint",
          "type": "string"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "With policy_id: the version that decided.",
          "title": "Policy Version"
        },
        "policy_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Name"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DATA only: answer, memory_candidate or summary.",
          "title": "Target"
        },
        "message_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Block only: the policy's own message.",
          "title": "Message Ar"
        },
        "message_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Block only: the policy's own message.",
          "title": "Message En"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The checker's explanation.",
          "title": "Detail"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The checker's reason key; `_cached` marks a cached judge verdict.",
          "title": "Reason"
        },
        "reason_args": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Judge: category and confidence.",
          "title": "Reason Args",
          "type": "object"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "entities": {
          "default": [],
          "description": "Entity types matched; never the matched text.",
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuardUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The check's own model calls (the judge's), absent for a cached verdict; never part of the turn usage a client receives (ADR-0118)."
        }
      },
      "required": [
        "checkpoint",
        "action"
      ],
      "title": "GuardAuditData",
      "type": "object"
    },
    "GuardData": {
      "additionalProperties": false,
      "description": "What a client sees of a guard evaluation: who decided what, never how (ADR-0116). No\nchecker explanation, reason, confidence, category, cache status, entities or latency.",
      "properties": {
        "checkpoint": {
          "title": "Checkpoint",
          "type": "string"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "With policy_id: the version that decided.",
          "title": "Policy Version"
        },
        "policy_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Name"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DATA only: answer, memory_candidate or summary.",
          "title": "Target"
        },
        "message_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Block only: the policy's own message.",
          "title": "Message Ar"
        },
        "message_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Block only: the policy's own message.",
          "title": "Message En"
        }
      },
      "required": [
        "checkpoint",
        "action"
      ],
      "title": "GuardData",
      "type": "object"
    },
    "GuardEvent": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "guard",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/GuardData"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "GuardEvent",
      "type": "object"
    },
    "GuardUsage": {
      "additionalProperties": false,
      "properties": {
        "tokens_in": {
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "required": [
        "tokens_in",
        "tokens_out"
      ],
      "title": "GuardUsage",
      "type": "object"
    },
    "ProgressData": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "step": {
          "description": "Machine-readable step name inside the capability, e.g. search or fetch.",
          "title": "Step",
          "type": "string"
        },
        "current": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "capability",
        "step"
      ],
      "title": "ProgressData",
      "type": "object"
    },
    "ProgressEvent": {
      "additionalProperties": false,
      "description": "A capability reports how far it got (ADR-0047).",
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "progress",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ProgressData"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "ProgressEvent",
      "type": "object"
    },
    "RetractData": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Error code of the check that withdrew the streamed text (ADR-0039).",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "RetractData",
      "type": "object"
    },
    "RetractEvent": {
      "additionalProperties": false,
      "description": "Withdraws every answer token streamed so far in this turn.",
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "retract",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/RetractData"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "RetractEvent",
      "type": "object"
    },
    "SkillData": {
      "additionalProperties": false,
      "description": "The skill applied to this turn's answer (phase 06, ADR-0301): its slug and its name per\nlocale, from its SKILL.md. Sent before the answer's first token; never the skill's text.",
      "properties": {
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/SkillLabel"
        }
      },
      "required": [
        "slug",
        "label"
      ],
      "title": "SkillData",
      "type": "object"
    },
    "SkillEvent": {
      "additionalProperties": false,
      "description": "The skill the answer is written with (phase 06); precedes the answer's tokens.",
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "skill",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/SkillData"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "SkillEvent",
      "type": "object"
    },
    "SkillLabel": {
      "additionalProperties": false,
      "properties": {
        "ar": {
          "title": "Ar",
          "type": "string"
        },
        "en": {
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "ar",
        "en"
      ],
      "title": "SkillLabel",
      "type": "object"
    },
    "StateDigest": {
      "additionalProperties": false,
      "properties": {
        "turn": {
          "title": "Turn",
          "type": "integer"
        },
        "capabilities": {
          "description": "Capability slugs that ran this turn, in order.",
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "slug@version of the skill applied to the answer, if any (phase 06, G8).",
          "title": "Skill"
        }
      },
      "required": [
        "turn",
        "capabilities"
      ],
      "title": "StateDigest",
      "type": "object"
    },
    "TierData": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "role",
        "tier",
        "reason"
      ],
      "title": "TierData",
      "type": "object"
    },
    "TierEvent": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "seq": {
          "description": "Monotonic per turn, starting at 0. -1 marks an event injected by the gateway.",
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "tier",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TierData"
        }
      },
      "required": [
        "request_id",
        "turn_id",
        "seq",
        "type",
        "data"
      ],
      "title": "TierEvent",
      "type": "object"
    },
    "TokenData": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TokenData",
      "type": "object"
    },
    "TokenEvent": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
