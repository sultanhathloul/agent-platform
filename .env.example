# Copy to .env with `make env` (scripts/init_env.sh). Every value written as
# __generate__ (or containing it) is replaced with a random secret; everything
# else is copied as-is. Never commit .env.

# ---------------------------------------------------------------- project
COMPOSE_PROJECT_NAME=agent-platform

# ---------------------------------------------------------------- host ports
WEB_PORT=3000
GATEWAY_PORT=8080
KEYCLOAK_PORT=8081
LANGFUSE_PORT=3001

# ---------------------------------------------------------------- browser-facing URLs
# Must match the host ports above. The Keycloak URL is also the token issuer.
WEB_PUBLIC_URL=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
LANGFUSE_PUBLIC_URL=http://localhost:3001

# ---------------------------------------------------------------- postgres
# Superuser, used only by the init scripts.
POSTGRES_PASSWORD=__generate__
# One owner role per database (infra/postgres/init).
APP_DB_PASSWORD=__generate__
BUSINESS_DB_PASSWORD=__generate__
KEYCLOAK_DB_PASSWORD=__generate__
LANGFUSE_DB_PASSWORD=__generate__

# ---------------------------------------------------------------- redis
REDIS_PASSWORD=__generate__

# ---------------------------------------------------------------- minio (object storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=__generate__
# One MinIO user per service (owner decision S7); only minio-init uses the root user above.
# gateway: writes, reads and discards uploads; ingest: reads uploads; sweeper: lists and removes
# objects no attachment names; langfuse: its own bucket.
MINIO_GATEWAY_ACCESS_KEY=gateway-uploads
MINIO_GATEWAY_SECRET_KEY=__generate__
MINIO_INGEST_ACCESS_KEY=ingest-uploads
MINIO_INGEST_SECRET_KEY=__generate__
MINIO_SWEEPER_ACCESS_KEY=sweeper-uploads
MINIO_SWEEPER_SECRET_KEY=__generate__
MINIO_LANGFUSE_ACCESS_KEY=langfuse-events
MINIO_LANGFUSE_SECRET_KEY=__generate__

# ---------------------------------------------------------------- keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=__generate__
# Secret of the confidential `gateway` client (service account).
KC_GATEWAY_CLIENT_SECRET=__generate__
# Realm and clients (infra/keycloak/realm-export.json).
KC_REALM=agent
KC_WEB_CLIENT_ID=web
KC_GATEWAY_CLIENT_ID=gateway

# ---------------------------------------------------------------- models
# LiteLLM serves the tier aliases fast, standard, heavy and embed with these
# models (infra/litellm/config.yaml, ADR-0066). The defaults are the offline
# profile: local Ollama, no key, no network. `make models` pulls them.
FAST_MODEL=ollama_chat/qwen2.5:3b
STANDARD_MODEL=ollama_chat/qwen2.5:14b-instruct
HEAVY_MODEL=ollama_chat/gemma4:31b
# Where the three chat tiers are served, and its key (empty for Ollama).
MODEL_API_BASE=http://host.docker.internal:11434
MODEL_API_KEY=
EMBED_MODEL=ollama/bge-m3
EMBED_API_BASE=http://host.docker.internal:11434
# The reranker (ADR-0134, R1): the stack's own Infinity server by default, whose weights `make models`
# fetches into the volume rerank-models. Point both at another Infinity server to use it instead.
RERANK_MODEL=infinity/bge-reranker-v2-m3
RERANK_API_BASE=http://rerank:7997
# Whether retrieval reranks, and how (review round 2, finding 3; overrides config/docs.yaml). The
# reranker on CPU adds seconds per query, so development leaves it off (hybrid fusion alone met every
# rag threshold, ADR-0184). In production, on a GPU host, turn it on:
#   RERANK_ENABLED=true
#   RERANK_CANDIDATES=16          # fused chunks scored by the cross-encoder
#   RERANK_MAX_CHARS=1070         # characters of each scored (400 reranker tokens); empty = whole chunk
# Citation page accuracy behind each setting, three rag runs: off 0.91–0.94; 16/1070 0.97–1.00.
RERANK_ENABLED=false
RERANK_CANDIDATES=16
RERANK_MAX_CHARS=1070
# Provider parameters OpenRouter reads and Ollama ignores: no hidden reasoning
# tokens, and no silent switch to another provider of the model.
MODEL_REASONING_ENABLED=false
MODEL_PROVIDER_ALLOW_FALLBACKS=false
# OpenRouter profile (README §21.4, ADR-0065): replace the five lines above with
#   FAST_MODEL=openrouter/google/gemma-4-26b-a4b-it
#   STANDARD_MODEL=openrouter/qwen/qwen3.6-27b
#   HEAVY_MODEL=openrouter/deepseek/deepseek-v4-flash
#   MODEL_API_BASE=https://openrouter.ai/api/v1
#   MODEL_API_KEY=<OpenRouter key>
# Embeddings stay on Ollama. No real or ministry data in dev on that profile.
LITELLM_MASTER_KEY=sk-__generate__

# ---------------------------------------------------------------- gateway <-> agent
# Shared secret header on the internal network (README §6.2).
AGENT_INTERNAL_TOKEN=__generate__
# Salt for hashing user ids in traces (README §12).
USER_ID_HASH_SALT=__generate__
# Key of the HMAC-SHA256 that stands in for memory, summary and extractor text in traces and
# for every model call's input and output hashes (phase 03 D5, ADR-0110). Required by the agent.
CONTENT_HASH_KEY=__generate__
# Record prompt and completion text on model spans. Set false where traces must not hold content.
OBSERVABILITY_CAPTURE_CONTENT=true
# Record every context package and serve GET /v1/debug/context/{turn_id} on the agent (README §7).
# The packages hold user content; keep false outside development.
DEBUG_CONTEXT_ENABLED=false
# Recorded context packages expire after this many days (phase 03, D5).
DEBUG_CONTEXT_RETENTION_DAYS=7
# Dedicated Postgres connections for per-conversation turn locks: at most this many turns
# run at once across conversations (phase 03, D6).
LOCK_POOL_SIZE=20
# The per-user upload rate the gateway enforces (review round 2, finding 4; overrides
# config/docs.yaml's baseline of 20). Development sets it well above what `make eval` uploads per
# minute (it uploads a document per rag/routing case, spaced by each turn), so evals never sleep on
# a 429. Production sets a real limit, e.g. 20.
UPLOADS_PER_MINUTE=60

# ---------------------------------------------------------------- langfuse (v3, headless init)
LANGFUSE_NEXTAUTH_SECRET=__generate__
LANGFUSE_SALT=__generate__
# Must be 64 hex characters; the generator produces exactly that.
LANGFUSE_ENCRYPTION_KEY=__generate__
LANGFUSE_INIT_ORG_ID=agent-platform
LANGFUSE_INIT_ORG_NAME="Agent Platform"
LANGFUSE_INIT_PROJECT_ID=agent-platform
LANGFUSE_INIT_PROJECT_NAME=agent-platform
LANGFUSE_PUBLIC_KEY=pk-lf-__generate__
LANGFUSE_SECRET_KEY=sk-lf-__generate__
LANGFUSE_ADMIN_EMAIL=admin@agent.local
LANGFUSE_ADMIN_PASSWORD=__generate__
CLICKHOUSE_PASSWORD=__generate__
